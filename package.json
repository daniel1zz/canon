{
  "name": "@daniel1zz/canon",
  "version": "0.0.1",
  "description": "Shared memory and coordination for a project built by many concurrent AI sessions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel1zz/canon.git"
  },
  "bin": {
    "canon": "dist/canon.js"
  },
  "files": [
    "dist/canon.js",
    ".claude/skills/canon-*/**"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "sh scripts/test.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun build --compile src/invocation/main.ts --outfile dist/canon",
    "build:npm": "bun build src/invocation/main.ts --target bun --outfile dist/canon.js",
    "prepublishOnly": "bun run build:npm"
  },
  "devDependencies": {
    "citty": "^0.1.6",
    "yaml": "^2.7.1",
    "ajv": "^8.20.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.8.3"
  }
}
